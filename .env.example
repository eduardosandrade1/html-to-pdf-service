PORT=3000
HOST=0.0.0.0
PDF_API_KEY=change-me
MAX_HTML_SIZE_MB=10
OUTPUT_DIR=./output
PDF_BASE_URL=http://localhost:3000
PDF_RETENTION_HOURS=24
LOG_LEVEL=info

# Timeout máximo (em ms) para a geração de um PDF antes de retornar 504
PDF_TIMEOUT_MS=60000

# CORS: use "*" para liberar todas as origens, ou uma lista separada por
# vírgula (ex: https://app.exemplo.com,https://admin.exemplo.com)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Intervalo (em ms) entre execuções da rotina de limpeza de arquivos antigos
CLEANUP_INTERVAL_MS=900000

NODE_ENV=production
